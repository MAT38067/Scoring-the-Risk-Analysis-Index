* Encoding: UTF-8.
***RAI-ICD CODING SYNTAX***
    
IF  (
    ((CHAR.INDEX(DIAG_CONCAT,'$C153') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C154') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C155') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C158') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C159') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z8501')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C220') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C221') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C222') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C223') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C224') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C227') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C228') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C229') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z8505')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C250') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C251') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C252') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C253') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C254') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C257') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C258') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C258') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C259') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z8507')=0)
    or
    (CHAR.INDEX(DIAG_CONCAT,'$C33') > 0 and CHAR.INDEX(DIAG_CONCAT,'$Z8512')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C3400') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3401') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C3402') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3410') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C3411') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3412') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C342') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3430') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C3431') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3432') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3480') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3481') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C3482') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3490') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3491') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C3492') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z85118')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C710') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C711') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C712') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C713') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C714') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C715') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C716') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C717') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C718') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C719') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z85841')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C9200') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9202') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C9260') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9262') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C92A0') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C92A2') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z856')=0)
    or
    ((CHAR.INDEX(DIAG_CONCAT,'$C9300') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9302') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9310') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9312') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$C9330') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9332') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C93Z0') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C93Z2') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C9390') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C9392') > 0) and CHAR.INDEX(DIAG_CONCAT,'$Z856')=0)
    or
    CHAR.INDEX(DIAG_CONCAT,'$C23') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C240') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C241') > 0 
    or CHAR.INDEX(DIAG_CONCAT,'$C248') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C249') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C450') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C451') > 0  or CHAR.INDEX(DIAG_CONCAT,'$C452') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C457') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C459') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C770') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C771') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C772') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C773') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C774') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C775') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C778') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C779') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7800') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7801') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7802') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C781') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C782') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7830') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7839') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C784') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C785') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C786') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C787') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7880') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7889') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7900') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7901') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7902') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7910') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7911') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7919') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C792') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7931') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7932') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7940') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7949') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7951') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7952') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7960') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7961') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7962') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7963') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7970') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7971') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7972') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7981') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7982') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7989') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C799') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C800') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B00') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7B01') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B02') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B03') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B04') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$C7B09') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B1') > 0 or CHAR.INDEX(DIAG_CONCAT,'$C7B8') > 0 ) RAI_CANCER_SEV=1. 
EXECUTE. 

RECODE RAI_CANCER_SEV (MISSING=0). 
EXECUTE. 

RECODE AGE (0 thru 19=0) (20 thru 24=2) (25 thru 29=4) (30 thru 34=6) (35 thru 39=9) (40 thru 44=11) 
    (45 thru 49=13) (50 thru 54=15) (55 thru 59=18) (60 thru 64=20) (65 thru 69=22) (70 thru 74=25) (75 
    thru 79=27) (80 thru 84=29) (85 thru 89=31) (90 thru 94=34) (95 thru 99=36) (100 thru 500=38) INTO 
    RAI_AGE_NO_CANCER. 
EXECUTE. 

RECODE AGE (0 thru 19=43) (20 thru 24=43) (25 thru 29=43) (30 thru 34=44) (35 thru 39=44) (40 thru 44=44) 
    (45 thru 49=44) (50 thru 54=44) (55 thru 59=44) (60 thru 64=45) (65 thru 69=45) (70 thru 74=45) (75 
    thru 79=45) (80 thru 84=45) (85 thru 89=46) (90 thru 94=46) (95 thru 99=46) (100 thru 500=46) INTO 
    RAI_AGE_CANCER. 
EXECUTE. 

IF  (FEMALE = 0) RAI_MALE=3. 
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$R634') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R636') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$R64') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R627') > 0 or CHAR.INDEX(DIAG_CONCAT,'$M6284') > 0 or
    CHAR.INDEX(DIAG_CONCAT,'$M6250') > 0) RAI_WEIGHT_LOSS=2. 
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$R630') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R6339') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$R638') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R6330') > 0) RAI_POOR_APP=1. 
EXECUTE.

IF  (CHAR.INDEX(DIAG_CONCAT,'$N184') > 0 or CHAR.INDEX(DIAG_CONCAT,'$N185') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$N186') > 0 or CHAR.INDEX(DIAG_CONCAT,'$I120') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$I1311') > 0 or CHAR.INDEX(DIAG_CONCAT,'$I132') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$Z4901') > 0  or CHAR.INDEX(DIAG_CONCAT,'$Z4902') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z4931') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z4932') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$Z992') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z9115') > 0) RAI_REN_FAIL=3.
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$I50') > 0 or CHAR.INDEX(DIAG_CONCAT,'$I0981') > 0 or CHAR.INDEX(DIAG_CONCAT,'$I110') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$I130') > 0) RAI_HEART_FAIL=3. 
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$R060') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z9981') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$J961') > 0) RAI_SOB=2. 
EXECUTE.

IF  (CHAR.INDEX(DIAG_CONCAT,'$G81') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G8221') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$G8222') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G831') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$G832') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z741') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$Z742') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z736') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z9181') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$R260') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R261') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R262') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R2681') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$R269') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R54') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R531') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R538') > 0
    or CHAR.INDEX(DIAG_CONCAT,'$R530') > 0 or CHAR.INDEX(DIAG_CONCAT,'$M6281') > 0 or CHAR.INDEX(DIAG_CONCAT,'$M623') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$L89') > 0) RAI_PART_DEP=1. 
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$Z7401') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z7409') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$Z743') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z993') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$R532') > 0 or CHAR.INDEX(DIAG_CONCAT,'$Z9989') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G8250') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$G8251') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G8252') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G8253') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$G8254') > 0) RAI_TOT_DEP=2. 
EXECUTE. 

IF  (CHAR.INDEX(DIAG_CONCAT,'$F01') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F02') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$F03') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F04') > 0 or CHAR.INDEX(DIAG_CONCAT,'$G30') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$G31') > 0 or CHAR.INDEX(DIAG_CONCAT,'$R4181') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1096') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$F1027') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1097') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1327') > 0  or 
    CHAR.INDEX(DIAG_CONCAT,'$F1397') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1897') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1917') > 0 or 
    CHAR.INDEX(DIAG_CONCAT,'$F1927') > 0 or CHAR.INDEX(DIAG_CONCAT,'$F1997') > 0) RAI_COG_DEC=1. 
EXECUTE. 

RECODE RAI_CANCER_SEV RAI_MALE RAI_WEIGHT_LOSS RAI_POOR_APP RAI_REN_FAIL RAI_HEART_FAIL RAI_SOB RAI_PART_DEP RAI_TOT_DEP RAI_COG_DEC
    (MISSING=0). 
EXECUTE. 

COMPUTE RAI_FUNC_STAT = MAX(RAI_PART_DEP, RAI_TOT_DEP).
EXECUTE.

COMPUTE RAI_BASE = RAI_MALE+RAI_WEIGHT_LOSS+RAI_POOR_APP+RAI_REN_FAIL+RAI_HEART_FAIL+RAI_SOB.
EXECUTE.

IF  (RAI_CANCER_SEV = 1) RAI_AGE_CANCER_SEV=RAI_AGE_CANCER. 
EXECUTE. 

IF  (RAI_CANCER_SEV = 0) RAI_AGE_NO_CANCER_SEV=RAI_AGE_NO_CANCER. 
EXECUTE. 

RECODE RAI_AGE_CANCER_SEV RAI_AGE_NO_CANCER_SEV (MISSING=0).
EXECUTE.

COMPUTE RAI_BASE_W_AGE = RAI_BASE+RAI_AGE_CANCER_SEV+RAI_AGE_NO_CANCER_SEV.
EXECUTE.

IF  (RAI_FUNC_STAT=2 and RAI_COG_DEC =1) TOT_DEP_COG_DEC=21. 
EXECUTE. 

IF  (RAI_FUNC_STAT=2 and RAI_COG_DEC =0) TOT_DEP_NO_COG_DEC=20. 
EXECUTE. 

IF  (RAI_FUNC_STAT=1 and RAI_COG_DEC =1) PART_DEP_COG_DEC=15. 
EXECUTE. 

IF  (RAI_FUNC_STAT=1 and RAI_COG_DEC =0) PART_DEP_NO_COG_DEC=10. 
EXECUTE. 

IF  (RAI_FUNC_STAT=0 and RAI_COG_DEC =1) INDEP_COG_DEC=9. 
EXECUTE.

IF  (RAI_FUNC_STAT=0 and RAI_COG_DEC =0) INDEP_NO_COG_DEC=0. 
EXECUTE. 

RECODE TOT_DEP_COG_DEC TOT_DEP_NO_COG_DEC PART_DEP_COG_DEC PART_DEP_NO_COG_DEC INDEP_COG_DEC INDEP_NO_COG_DEC (MISSING=0).
EXECUTE.

COMPUTE RAI_COMPLETE = RAI_BASE_W_AGE + TOT_DEP_COG_DEC + TOT_DEP_NO_COG_DEC + PART_DEP_COG_DEC + 
    PART_DEP_NO_COG_DEC + INDEP_COG_DEC + INDEP_NO_COG_DEC.
EXECUTE.
